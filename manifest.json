{
  "manifest_version": 3,
  "name": "Live Data Playback Delay",
  "version": "2.0.0",
  "description": "Slow down live streaming chart ticks and quote updates on Engine.IO v3 WebSockets for analysis and verification.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/sw.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/inject.js",
        "content/banner.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
